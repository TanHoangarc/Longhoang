rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // News articles collection
    match /news/{articleId} {
      allow read, write: if true;
    }
    
    // Career / Job openings collection
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
